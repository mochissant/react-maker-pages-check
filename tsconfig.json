{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@usefluid/motion": ["./src/vendor/usefluid-motion/index.d.ts"],
      "@usefluid/motion/react": ["./src/vendor/usefluid-motion/react.d.ts"]
    }
  },
  "include": ["src"]
}
